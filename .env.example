# ---- ScriptNymous : variables d'environnement ----
# Mot de passe de l'unique utilisateur. Haché au premier démarrage et stocké en base ;
# changer cette valeur ensuite ne remplace PAS le mot de passe en base (voir SN_RESET_PASSWORD).
SN_PASSWORD=changez-moi

# Mettre à 1 pour forcer le re-hachage de SN_PASSWORD au prochain démarrage (mot de passe oublié).
SN_RESET_PASSWORD=0

# Secret de signature des cookies de session (généré et stocké en base s'il est absent).
# SN_SESSION_SECRET=

# Port d'écoute HTTP dans le conteneur.
SN_PORT=8080

# Dossiers (valeurs par défaut dans le conteneur ; en dev local, voir server/package.json).
SN_SCRIPTS_DIR=/scripts
SN_DATA_DIR=/data

# Fuseau horaire par défaut des planifications (surchargeable par script).
TZ=Europe/Paris

# URL publique (utilisée dans les liens des notifications ntfy).
SN_PUBLIC_URL=https://scripts.exemple.fr

# ntfy (valeurs par défaut, surchargeables depuis la page Réglages et par script).
SN_NTFY_SERVER=https://ntfy.sh
SN_NTFY_TOPIC=scriptnymous
# SN_NTFY_TOKEN=

# Purge des journaux : ancienneté maximale en jours et taille maximale totale en Mo (0 = illimité).
SN_LOG_RETENTION_DAYS=30
SN_LOG_MAX_MB=500

# Identité du processus dans le conteneur (facultatif).
PUID=1000
PGID=1000

# Journalisation du serveur : fatal | error | warn | info | debug | trace
SN_LOG_LEVEL=info
